      },
      "extraction": {
        "prompt_template": "The following markdown section describes the Codex plugin structure. Return the path, relative to the plugin root, of the Codex overlay manifest file, as a JSON string. {{section}}",
        "output_schema": {
          "type": "string"
        },
        "post_processing": null
      },
      "assertion_location": {
        "file": "packages/skilllint/plugin_validator.py",
        "symbol": "CODEX_PLUGIN_MANIFEST",
        "source_type": "python_constant"
      },
      "expected_value": ".codex-plugin/plugin.json",
      "x-audited": {
        "date": "2026-09-27",
        "source": ".claude/vendor/sources/codex--plugins--build-2026-09-27-1158.md"
      }
    }
  }
